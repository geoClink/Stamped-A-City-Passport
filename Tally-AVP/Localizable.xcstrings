        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "팁은 감사의 표시일 뿐이에요. 잠금 해제되는 기능은 없으며, 앱의 모든 기능은 계속 무료입니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
