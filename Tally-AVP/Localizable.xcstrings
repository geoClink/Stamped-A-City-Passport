    "Based on the data, which landmark is this?" : {
      "comment" : "Quiz prompt (QuestionType.name). Reused from the iPhone app's Localizable.strings (question.name). REVIEW: de/fr/it fixed: iPhone says 'Meilenstein' (milestone) / 'point de repère' / 'punto di riferimento' (reference point); es was untranslated on iPhone.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welches Wahrzeichen ist das, basierend auf den Daten?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Según los datos, ¿qué monumento es este?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "D'après les données, de quel monument s'agit-il ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In base ai dati, di quale monumento si tratta?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "データに基づくと、これはどのランドマークですか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "데이터에 따르면, 이것은 어떤 랜드마크인가요?"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com base nos dados, que marco é esse?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
