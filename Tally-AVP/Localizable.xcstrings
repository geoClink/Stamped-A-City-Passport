    "Payments go through your Apple Account. Tips are one-time and don't renew." : {
      "comment" : "Tip jar: footnote",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Zahlung läuft über deinen Apple Account. Trinkgelder sind einmalig und verlängern sich nicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los pagos se hacen con tu Cuenta de Apple. Las propinas son únicas y no se renuevan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le paiement passe par votre compte Apple. Les pourboires sont ponctuels et ne se renouvellent pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I pagamenti avvengono tramite il tuo Account Apple. Le mance sono una tantum e non si rinnovano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "支払いは Apple アカウントを通じて行われます。チップは1回限りで、自動更新されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "결제는 Apple 계정을 통해 이루어집니다. 팁은 일회성이며 갱신되지 않습니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os pagamentos são feitos pela sua Conta Apple. As gorjetas são únicas e não se renovam."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "付款通过你的 Apple 账户完成。打赏为一次性付款，不会续订。"
          }
        }
      }
    },
