    "Fly to each landmark and hear its story" : {
      "comment" : "Help text for Play Tour",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fliege zu jedem Bauwerk und höre seine Geschichte"
