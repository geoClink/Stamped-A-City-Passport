    "Stamp a landmark to start your passport.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stamp a landmark to start your passport."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stempeln Sie ein Wahrzeichen, um Ihren Pass zu beginnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sella un monumento para empezar tu pasaporte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamponnez un monument pour commencer votre passeport."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Timbra un luogo simbolo per iniziare il tuo passaporto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ランドマークにスタンプして、パスポートを始めましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "랜드마크에 스탬프를 찍고 여권을 시작하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Carimbe um marco para começar seu passaporte."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给一个地标盖章，开始你的护照之旅。"
          }
        }
      }
    },
    "Your stamps, cities and latest landmark at a glance.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your stamps, cities and latest landmark at a glance."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Stempel, Städte und das neueste Wahrzeichen auf einen Blick."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus sellos, ciudades y último monumento de un vistazo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos tampons, vos villes et votre dernier monument en un coup d'œil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi timbri, le città e l'ultimo luogo simbolo a colpo d'occhio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スタンプ、都市、最新のランドマークをひと目で。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스탬프, 도시, 최근 랜드마크를 한눈에."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus carimbos, cidades e o marco mais recente num relance."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一眼查看你的印章、城市和最新地标。"
          }
        }
      }
    },
